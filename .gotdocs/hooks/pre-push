#!/bin/sh
# gotdocs-managed-hook v1
#
# gotdocs pre-push hook.
#
# Runs `bin/gotdocs check --base <ref>` over everything the push would publish.
#
# The base is the remote sha git itself hands this hook on stdin for the ref
# being pushed -- that is the commit the remote is actually on, which is the
# only base that is right for `git push origin HEAD:release`, a push from a
# detached HEAD, or any push whose target is not the current branch's upstream.
# It falls back, in order, to: @{upstream}, origin/HEAD, origin/main, the
# repository's root commit.
#
# Source of truth for this file is .gotdocs/hooks/pre-push. It is copied into
# the repository hooks directory by scripts/install-gotdocs.sh. Do not edit the
# installed copy; edit the source and re-run the installer.
#
# Warn-only unless enforce.pre_push in .gotdocs/config.json says otherwise.
# Exits non-zero ONLY when the configured mode is "error".

set -eu

HOOK_NAME='pre-push'
DEFAULT_MODE='warn'
DEFAULT_SKIP_TOKEN='[gotdocs skip]'

# ---------------------------------------------------------------------------
# Resolve this hook's own path before changing directory.
# ---------------------------------------------------------------------------
HOOK_SELF=$0
case $HOOK_SELF in
    /*) ;;
    *) HOOK_SELF="$PWD/$HOOK_SELF" ;;
esac

# ---------------------------------------------------------------------------
# git feeds pre-push a list of "<local ref> <local sha> <remote ref> <remote sha>"
# lines on stdin. Read it once here so it can be replayed to a chained hook.
# ---------------------------------------------------------------------------
STDIN_DATA=$(cat 2>/dev/null || true)

# ---------------------------------------------------------------------------
# Chain: run any pre-existing hook the installer moved aside, with the same
# arguments and a replay of stdin. Its veto wins.
# ---------------------------------------------------------------------------
exec_local_hook() {
    if [ -x "$HOOK_SELF.local" ]; then
        "$HOOK_SELF.local" "$@"
    else
        sh "$HOOK_SELF.local" "$@"
    fi
}

if [ -f "$HOOK_SELF.local" ]; then
    if [ -n "$STDIN_DATA" ]; then
        printf '%s\n' "$STDIN_DATA" | exec_local_hook "$@"
    else
        exec_local_hook "$@" </dev/null
    fi
fi

# ---------------------------------------------------------------------------
# Explicit opt-out.
# ---------------------------------------------------------------------------
case "${GOTDOCS_SKIP:-}" in
    1 | true | TRUE | yes | YES) exit 0 ;;
    *) ;;
esac

if ! command -v git >/dev/null 2>&1; then
    exit 0
fi

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || true)
[ -n "$REPO_ROOT" ] || exit 0
cd "$REPO_ROOT" || exit 0

GIT_DIR_PATH=$(git rev-parse --git-dir 2>/dev/null || true)
[ -n "$GIT_DIR_PATH" ] || exit 0
case $GIT_DIR_PATH in
    /*) ;;
    *) GIT_DIR_PATH="$REPO_ROOT/$GIT_DIR_PATH" ;;
esac

if [ -e "$GIT_DIR_PATH/MERGE_HEAD" ] ||
    [ -e "$GIT_DIR_PATH/CHERRY_PICK_HEAD" ] ||
    [ -e "$GIT_DIR_PATH/REVERT_HEAD" ] ||
    [ -d "$GIT_DIR_PATH/rebase-merge" ] ||
    [ -d "$GIT_DIR_PATH/rebase-apply" ]; then
    exit 0
fi

# ---------------------------------------------------------------------------
# A push that only deletes remote refs publishes no code, so there is nothing
# to check. An empty stdin (hook invoked by hand) is treated as "do check".
# ---------------------------------------------------------------------------
HAS_UPDATE=1
if [ -n "$STDIN_DATA" ]; then
    HAS_UPDATE=0
    while read -r _ _lsha _ _; do
        case "${_lsha:-}" in
            '') ;;
            *[!0]*) HAS_UPDATE=1 ;;
            *) ;;
        esac
    done <<STDIN_REPLAY
$STDIN_DATA
STDIN_REPLAY
fi
if [ "$HAS_UPDATE" -eq 0 ]; then
    exit 0
fi

CONFIG_FILE="$REPO_ROOT/.gotdocs/config.json"

# ---------------------------------------------------------------------------
# Minimal reader for flat "key": "value" pairs in .gotdocs/config.json.
#   $1 = key name, $2 = default value
# ---------------------------------------------------------------------------
config_string() {
    _cs_key=$1
    _cs_default=$2
    _cs_value=''
    if [ -f "$CONFIG_FILE" ]; then
        _cs_value=$(
            tr -d '\r' <"$CONFIG_FILE" 2>/dev/null | tr '\n' ' ' |
                sed -n 's/.*"'"$_cs_key"'"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p'
        ) || _cs_value=''
    fi
    if [ -n "$_cs_value" ]; then
        printf '%s\n' "$_cs_value"
    else
        printf '%s\n' "$_cs_default"
    fi
    unset _cs_key _cs_default _cs_value
}

# ---------------------------------------------------------------------------
# Enforcement mode, read from the "enforce" object only. A bare key search over
# the whole file would pick up a same-named key from the nested "debt" or
# "publish" blocks.
#   $1 = context name, $2 = default
# ---------------------------------------------------------------------------
config_mode() {
    _cm_key=$1
    _cm_default=$2
    _cm_value=''
    if [ -f "$CONFIG_FILE" ]; then
        _cm_value=$(
            tr -d '\r' <"$CONFIG_FILE" 2>/dev/null | tr '\n' ' ' |
                sed -n 's/.*"enforce"[[:space:]]*:[[:space:]]*{\([^}]*\)}.*/\1/p' |
                sed -n 's/.*"'"$_cm_key"'"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p'
        ) || _cm_value=''
    fi
    case ${_cm_value:-} in
        off | warn | error) printf '%s\n' "$_cm_value" ;;
        *) printf '%s\n' "$_cm_default" ;;
    esac
    unset _cm_key _cm_default _cm_value
}

# enforce.pre_push is optional; absent means warn-only.
MODE=$(config_mode 'pre_push' "$DEFAULT_MODE")

if [ "$MODE" = 'off' ]; then
    exit 0
fi

SKIP_TOKEN=$(config_string 'skip_token' "$DEFAULT_SKIP_TOKEN")

warn() {
    printf 'gotdocs: %s\n' "$1" >&2
    printf 'gotdocs: skipping the %s check (push not blocked).\n' "$HOOK_NAME" >&2
}

# ---------------------------------------------------------------------------
# Resolve the comparison base.
#
# First choice is the remote sha git supplied for the ref being pushed: it is
# the commit the remote already has, so `<remote sha>...HEAD` is exactly the
# set of changes this push publishes. The current branch's @{upstream} is only
# a guess about that, and it is the wrong guess for `git push origin HEAD:main`,
# for a detached HEAD, and for a branch pushed to a differently-named remote ref.
#
# A remote sha of all zeros means the remote ref does not exist yet (a brand new
# branch); there is nothing to diff against, so fall through. So does a sha that
# is not present locally, which happens when the remote moved and nobody fetched.
# ---------------------------------------------------------------------------
BASE=''
HEAD_SHA=$(git rev-parse HEAD 2>/dev/null || true)
if [ -n "$STDIN_DATA" ]; then
    # `check --base REF` diffs REF...HEAD, so the line whose local sha *is* HEAD
    # is the one whose remote sha is the right base. Any other usable line is
    # kept as a fallback: a base slightly wider than the push is still far
    # better than the current branch's upstream, which may be unrelated.
    _fallback=''
    while read -r _lref _lsha _rref _rsha; do
        [ -n "${_lsha:-}" ] || continue
        case $_lsha in
            *[!0]*) ;;
            *) continue ;;   # deleting a remote ref publishes nothing
        esac
        case "${_rsha:-}" in
            *[!0]*)
                git rev-parse --verify --quiet "$_rsha^{commit}" >/dev/null 2>&1 || continue
                if [ -n "$HEAD_SHA" ] && [ "$_lsha" = "$HEAD_SHA" ]; then
                    BASE=$_rsha
                    break
                fi
                [ -n "$_fallback" ] || _fallback=$_rsha
                ;;
            *) ;;
        esac
    done <<STDIN_REPLAY
$STDIN_DATA
STDIN_REPLAY
    [ -n "$BASE" ] || BASE=$_fallback
fi

if [ -n "$BASE" ]; then
    :
elif git rev-parse --verify --quiet '@{upstream}' >/dev/null 2>&1; then
    BASE='@{upstream}'
elif git symbolic-ref --quiet refs/remotes/origin/HEAD >/dev/null 2>&1; then
    BASE='origin/HEAD'
elif git rev-parse --verify --quiet 'origin/main' >/dev/null 2>&1; then
    BASE='origin/main'
else
    BASE=$(git rev-list --max-parents=0 HEAD 2>/dev/null | tail -n 1 || true)
fi

if [ -z "$BASE" ]; then
    warn 'could not determine a base revision to compare against'
    exit 0
fi

# ---------------------------------------------------------------------------
# Skip token. pre-push reports on the *whole* range being published, so the
# token is honoured when any commit in that range carries it -- checking only
# HEAD would re-report a change that was already deliberately excused at commit
# time, with no way to excuse it again short of GOTDOCS_SKIP=1.
# ---------------------------------------------------------------------------
if [ -n "$SKIP_TOKEN" ]; then
    RANGE_MSGS=$(git log --format=%B "$BASE..HEAD" 2>/dev/null || true)
    if [ -z "$RANGE_MSGS" ]; then
        RANGE_MSGS=$(git log -1 --format=%B HEAD 2>/dev/null || true)
    fi
    if [ -n "$RANGE_MSGS" ]; then
        if printf '%s\n' "$RANGE_MSGS" | grep -qF -- "$SKIP_TOKEN" 2>/dev/null; then
            printf 'gotdocs: skipped (%s in a commit message being pushed)\n' "$SKIP_TOKEN" >&2
            exit 0
        fi
    fi
fi

if ! command -v python3 >/dev/null 2>&1; then
    warn 'python3 was not found on PATH'
    exit 0
fi

if [ ! -f 'bin/gotdocs' ]; then
    warn 'bin/gotdocs is missing from this repository'
    exit 0
fi

# Capture stdout only: that is where the findings report goes. Anything the CLI
# writes to stderr (warnings, tracebacks) streams straight to the terminal and
# is deliberately NOT treated as a finding.
#
# `--quiet` is what makes "empty stdout" mean "nothing to report": without it the
# CLI prints a "no findings" success line on a clean run, and every branch below
# keys off whether OUTPUT is empty, so a clean push would print the remediation
# block. With --quiet, clean / skipped / mode=off all produce no stdout, while a
# real findings report still prints in full.
set +e
if [ -x 'bin/gotdocs' ]; then
    OUTPUT=$(./bin/gotdocs check --base "$BASE" --quiet --mode "$MODE")
else
    OUTPUT=$(sh bin/gotdocs check --base "$BASE" --quiet --mode "$MODE")
fi
STATUS=$?
set -e

remediation_block() {
    cat >&2 <<REMEDIATION

------------------------------------------------------------------------
gotdocs: documentation covering this push may now be out of date.
Compared against: $BASE

Pick one:
  - ask Claude to run /gotdocs-update
  - edit the documents listed above, then commit them
  - run: bin/gotdocs verify <doc-id>   (reviewed, no change needed)

Bypass this push only:
  GOTDOCS_SKIP=1 git push ...
------------------------------------------------------------------------
REMEDIATION
}

case $STATUS in
    0)
        if [ -n "$OUTPUT" ]; then
            printf '%s\n' "$OUTPUT" >&2
            remediation_block
        fi
        exit 0
        ;;
    1)
        # Exit 1 means "findings, in error mode" -- but a CLI that dies before it
        # can report (broken vendored tree, bad merge, import error) also exits 1
        # with nothing on stdout. A real findings report is never empty, so treat
        # the empty case as a tool failure and let the push through.
        if [ -z "$OUTPUT" ]; then
            warn 'check exited 1 without producing a report, so it failed rather than found stale docs'
            exit 0
        fi
        printf '%s\n' "$OUTPUT" >&2
        remediation_block
        if [ "$MODE" = 'error' ]; then
            exit 1
        fi
        exit 0
        ;;
    *)
        if [ -n "$OUTPUT" ]; then
            printf '%s\n' "$OUTPUT" >&2
        fi
        warn "check exited with status $STATUS"
        if [ "$MODE" = 'error' ] && [ "$STATUS" -eq 2 ]; then
            exit 1
        fi
        exit 0
        ;;
esac
